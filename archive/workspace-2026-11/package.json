{
  "name": "tamil-nadu-to-world-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm --prefix sling-product/portfolio ci",
    "dev": "npm --prefix sling-product/portfolio run dev -- --host 0.0.0.0",
    "build": "npm --prefix sling-product/portfolio run build",
    "preview": "npm --prefix sling-product/portfolio run preview -- --host 0.0.0.0",
    "test": "npm --prefix sling-product/portfolio test",
    "lint": "npm --prefix sling-product/portfolio run lint",
    "verify": "npm test && npm run lint && npm run build",
    "assets:legacy": "python3 scripts/build-assets.py && python3 scripts/build-textures.py && node scripts/optimize-assets.mjs",
    "verify:legacy": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "zustand": "^5.0.15",
    "meshoptimizer": "^1.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "vite": "^6.2.0"
  }
}
