{
  "manifest_version": 3,
  "name": "GestureOS",
  "version": "0.1.0",
  "description": "Use any website with your hands. Point to move, pinch to click, two fingers to scroll. Camera stays on your device.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GestureOS (Alt+G)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "welcome.html",
  "permissions": ["offscreen", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "commands": {
    "toggle-gestureos": {
      "suggested_key": { "default": "Alt+G" },
      "description": "Start or stop GestureOS"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
